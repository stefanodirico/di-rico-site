---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import { getProjects, rungById, u, ORIGIN } from '../../lib/site';
import { crumbs } from '../../lib/schema';
const projects = getProjects();
const list = { '@type': 'ItemList', name: 'Work by Stefano Di Rico', itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${ORIGIN}/work/${p.slug}/`, name: p.title })) };
---
<Base
  title="Work and campaigns | Stefano Di Rico"
  description="Campaigns and projects by Stefano Di Rico: a 15,000-signature letter to Downing Street, mental health support in schools, Votes at 16 and exam reform."
  path="/work/" og="work" current="/work" schema={[list, crumbs([['Home', '/'], ['Work', '/work/']])]}>
  <div class="wrap" style="padding-bottom:72px">
    <nav class="crumb" aria-label="Breadcrumb"><a href={u('/')}>Home</a> / Work</nav>
    <header class="page-hero">
      <div>
        <p class="eyebrow">Notebook no. 1</p>
        <h1>Work</h1>
        <p class="lead">Campaigns I have helped to lead and projects I have built, mostly on young people's mental health, education and having a say. Each one links to its rung on <a href={u('/experience-ladder')}>my experience ladder</a>.</p>
      </div>
    </header>
    <ul class="cards work-cards">
      {projects.map((p, i) => {
        const r = rungById(p.rung);
        return (
          <li class="card" style={`--r:${[-1, 1, 0.5, -0.5][i % 4]}deg`}>
            {p.photo && <Pic name={p.photo} widths={[320, 480, 640]} sizes="(max-width: 860px) 90vw, 300px" class="card-img" />}
            <span class="kind">{p.kind} with {p.with} · {p.when}</span>
            <h2 class="ct"><a href={u('/work/' + p.slug)}>{p.title}</a></h2>
            <p class="cl">{p.summary}</p>
            {r && <a class="rb" href={u('/experience-ladder#' + r.id)}><span class="mini" aria-hidden="true"></span>On the ladder: {r.short}, {r.org}</a>}
          </li>
        );
      })}
    </ul>
  </div>
</Base>
