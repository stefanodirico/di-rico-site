---
import Base from '../../layouts/Base.astro';
import Listen from '../../components/Listen.astro';
import { site, u, getTranscript, ORIGIN } from '../../lib/site';
import { getPodcast } from '../../lib/podcast';
import { series, crumbs, PERSON_ID, SERIES_ID } from '../../lib/schema';

export async function getStaticPaths() {
  const { episodes } = await getPodcast();
  return episodes.map((ep, i) => ({ params: { slug: ep.slug }, props: { ep, newer: episodes[i - 1], older: episodes[i + 1] } }));
}
const { ep, newer, older } = Astro.props;
const { show } = await getPodcast();
const transcript = getTranscript(ep.slug);
const path = `/podcast/${ep.slug}/`;
const desc = (ep.text.length > 155 ? ep.text.slice(0, 152).replace(/\s+\S*$/, '') + '...' : ep.text);
const title = `${ep.guest}: ${ep.headline}`.length > 44 ? `${ep.guest} | Creating Your Ladder podcast` : `${ep.guest}: ${ep.headline} | Creating Your Ladder`;
const episode: any = {
  '@type': 'PodcastEpisode', '@id': ORIGIN + path + '#episode', url: ORIGIN + path,
  name: `${ep.guest}: ${ep.headline}`, alternateName: ep.fullTitle, episodeNumber: ep.number,
  datePublished: ep.isoDate, duration: ep.isoDuration, description: ep.text.slice(0, 600), inLanguage: 'en-GB',
  partOfSeries: { '@id': SERIES_ID }, author: { '@id': PERSON_ID },
  associatedMedia: { '@type': 'AudioObject', contentUrl: ep.audio, encodingFormat: 'audio/mpeg', duration: ep.isoDuration },
  ...(ep.image ? { image: ep.image } : {}),
  ...(transcript ? { transcript: transcript.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() } : {}),
};
const video = ep.youtubeId ? [{
  '@type': 'VideoObject', name: episode.name, description: episode.description, uploadDate: ep.isoDate,
  thumbnailUrl: `https://i.ytimg.com/vi/${ep.youtubeId}/hqdefault.jpg`, embedUrl: `https://www.youtube-nocookie.com/embed/${ep.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${ep.youtubeId}`,
}] : [];
---
<Base title={title} description={desc} path={path} og={'podcast-' + ep.slug} current="/podcast" ogType="article"
  schema={[series(show.image), episode, ...video, crumbs([['Home', '/'], ['Podcast', '/podcast/'], [ep.guest, path]])]}>
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb"><a href={u('/')}>Home</a> / <a href={u('/podcast')}>Podcast</a> / {ep.guest}</nav>
    <header class="page-hero">
      <div>
        <p class="eyebrow">Creating Your <span class="ladder-word">Ladder</span>, episode {ep.number}</p>
        <h1>{ep.guest}: {ep.headline}</h1>
        <p class="lead">{ep.line}</p>
        <p style="margin-top:10px;color:var(--muted)">Hosted by <a href={u('/about')}>Stefano Di Rico</a> · <time datetime={ep.isoDate}>{ep.dateLabel}</time> · {ep.durationLabel}</p>
      </div>
    </header>

    <section class="embed" aria-label="Listen to this episode">
      <p class="dot" style="color:#fff;font-size:1.125rem">EP {String(ep.number).padStart(2, '0')} · {ep.guest}</p>
      <audio class="audio" controls preload="none" src={ep.audio}>
        <a href={ep.audio}>Download the audio (MP3)</a>
      </audio>
      <p class="row" style="gap:8px 18px">
        <a href={site.podcast.spotify} rel="noopener" style="color:var(--baby)">Spotify</a>
        <a href={site.podcast.apple} rel="noopener" style="color:var(--baby)">Apple Podcasts</a>
        <a href={site.podcast.youtube} rel="noopener" style="color:var(--baby)">YouTube</a>
        <a href={ep.audio} style="color:var(--baby)">Download MP3</a>
      </p>
    </section>

    {ep.youtubeId && (
      <section class="embed" style="margin-top:24px" data-embed data-src={`https://www.youtube-nocookie.com/embed/${ep.youtubeId}`} data-title={`Video: ${ep.guest} on Creating Your Ladder`} data-height="420">
        <p class="ph">The YouTube player sets its own cookies, so it only loads if you allow embedded media.</p>
        <p class="ph row"><button type="button" class="btn js-only" data-embed-allow>Allow and load the video</button><a class="ghost" href={`https://www.youtube.com/watch?v=${ep.youtubeId}`} rel="noopener">Watch on YouTube instead</a></p>
      </section>
    )}

    <div class="two sec">
      <div class="main">
        <article class="sheet prose" aria-labelledby="notes-h">
          <h2 id="notes-h">Show notes</h2>
          <Fragment set:html={ep.html} />
        </article>

        <article class="sheet prose" style="margin-top:32px" id="transcript" aria-labelledby="tr-h">
          <h2 id="tr-h">Transcript</h2>
          {transcript
            ? <Fragment set:html={transcript} />
            : <p>The transcript for this episode is on its way. Until then, the show notes above cover what we talked about.</p>}
        </article>
      </div>
      <aside>
        <div class="panel blue">
          <h2>More episodes</h2>
          <ul>
            {newer && <li><a href={u('/podcast/' + newer.slug)}>Newer: {newer.guest}</a></li>}
            {older && <li><a href={u('/podcast/' + older.slug)}>Older: {older.guest}</a></li>}
            <li><a href={u('/podcast')}>All episodes</a></li>
          </ul>
        </div>
        <div class="panel"><Listen /></div>
      </aside>
    </div>
  </div>
</Base>
