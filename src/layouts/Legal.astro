---
import Base from './Base.astro';
import { u } from '../lib/site';
import { crumbs } from '../lib/schema';
interface Props { title: string; h1: string; description: string; path: string; updated: string }
const { title, h1, description, path, updated } = Astro.props;
---
<Base title={title} description={description} path={path} og="home" schema={[crumbs([['Home', '/'], [h1, path]])]}>
  <div class="wrap" style="padding-bottom:72px">
    <nav class="crumb" aria-label="Breadcrumb"><a href={u('/')}>Home</a> / {h1}</nav>
    <header class="page-hero"><div><h1>{h1}</h1><p style="margin-top:12px;color:var(--muted)">Last updated: {updated}</p></div></header>
    <article class="sheet prose plain" style="max-width:820px"><slot /></article>
  </div>
</Base>
